# SmarTanom Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Django Settings
DJANGO_SECRET_KEY=your-very-long-secret-key-here-min-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# Security Settings
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=true
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Database (Production - PostgreSQL)
DATABASE_URL=postgresql://username:password@db-host:5432/smartanom_prod
# OR use individual settings:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom_prod
# DB_USER=smartanom_user
# DB_PASSWORD=secure-password
# DB_HOST=db-server.example.com
# DB_PORT=5432

# Email (Production)
# Option A: Brevo HTTP API (bypasses SMTP ports; great for Render free tier)
EMAIL_TRANSPORT=brevo_api
BREVO_API_KEY=your-brevo-api-key
DEFAULT_FROM_EMAIL=SmarTanom <noreply@yourdomain.com>

# Option B: SMTP (e.g., Brevo relay) - comment Option A and set below
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-username
# SMTP_PASS=your-brevo-smtp-password
# EMAIL_USE_TLS=true

# Rate Limiting (Production)
OTP_REQUEST_THROTTLE=5/hour
OTP_VERIFY_THROTTLE=10/hour
LOGIN_ATTEMPT_THROTTLE=15/hour
DRF_USER_THROTTLE=2000/day
DRF_ANON_THROTTLE=500/day

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_ATTEMPTS=5

# Redis / Channels (WebSockets)
# For providers like Upstash, ALWAYS use TLS (rediss) on port 6379.
# Example with Upstash (replace with your credentials):
# REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@your-redis-host.upstash.io:6379
# If your provider gives redis://...:6379 without TLS, set REDIS_FORCE_TLS=true to auto-upgrade.
# REDIS_FORCE_TLS=true
