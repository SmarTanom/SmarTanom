# SmarTanom Backend Environment Configuration Template
# Copy this file to .env and replace the placeholder values

# Email Configuration for Gmail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password-here
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com

# Django Settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate-a-secure-django-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW=900  # 15 minutes in seconds
OTP_RATE_LIMIT_MAX=5       # Maximum OTP requests per window

# Database Configuration (Optional - uses Docker postgres if not set)
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# OR use discrete variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom_dev
# DB_USER=smartanom
# DB_PASSWORD=your-password-here
# DB_HOST=localhost
# DB_PORT=5432

# Redis Configuration (Optional - uses Docker redis if not set)
# REDIS_URL=redis://localhost:6379/0

# CORS Settings (for frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Security Settings for Production
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
