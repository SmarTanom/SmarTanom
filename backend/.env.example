# SmarTanom Environment Configuration
# Copy this file to .env and update with your actual values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Choose one option below)

# Option 1: Gmail Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=smartanom01@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password-here
DEFAULT_FROM_EMAIL=smartanom01@gmail.com

# Option 2: Console Backend (Development Only - prints to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Option 3: SendGrid Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=smartanom01@gmail.com

# Database Configuration (Optional - defaults to SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# OTP Configuration (Optional - has sensible defaults)
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_ATTEMPTS=5

# Security Settings (Production)
# SECURE_HSTS_SECONDS=31536000