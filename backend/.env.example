# SmarTanom Environment Configuration
# Copy this file to .env and update with your actual values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Choose one option below)

# Option 1: Gmail Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
# Core Django
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.com
ADMIN_URL=admin/

# Database (Postgres)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smartanom
DB_USER=smartanom
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
# Alternatively use DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=SmartAnom <noreply@yourdomain.com>

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_ATTEMPTS=5

# DRF Throttling
DRF_USER_THROTTLE=5000/day
DRF_ANON_THROTTLE=1000/day

# Security Overrides
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Admin bootstrap (optional)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe!123