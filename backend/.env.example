# SmarTanom Environment Configuration
# Copy this file to .env and update with your actual values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email & Google Configuration (Choose applicable options below)

# Database (Postgres)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smartanom
DB_USER=smartanom
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
# Alternatively use DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Email (Gmail or provider of choice)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=SmartAnom <noreply@yourdomain.com>

# Google Account Validation (no popup)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are optional here since we don't open a popup.
# If you enable domain enforcement, set GOOGLE_REQUIRE_DOMAIN to a comma-separated list
# of allowed Google Workspace domains. To strictly require Google MX records, set
# GOOGLE_ENFORCE_MX=true (may block some valid setups if MX isn't Google-managed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REQUIRE_DOMAIN=
GOOGLE_ENFORCE_MX=false
# Optional: for server-side tokeninfo testing only (not for production use)
# GOOGLE_TEST_ID_TOKEN=

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_ATTEMPTS=5

# DRF Throttling
DRF_USER_THROTTLE=5000/day
DRF_ANON_THROTTLE=1000/day

# Security Overrides
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Admin bootstrap (optional)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe!123