# ============================================================================
# SmarTanom Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Django Core Settings
# ----------------------------------------------------------------------------
# SECRET_KEY: Django secret key for cryptographic signing (REQUIRED in production)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production
# Alternative environment variable names (both supported):
# DJANGO_SECRET_KEY=your-secret-key-here

# DEBUG: Enable/disable debug mode (set to false in production)
DEBUG=true
# Alternative: DJANGO_DEBUG=true

# ALLOWED_HOSTS: Comma-separated list of allowed hostnames
# Example: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Alternative: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/smartanom
# DATABASE_URL=mysql://user:password@localhost:3306/smartanom

# Option 2: Use discrete database variables (good for development)
# Leave empty or use sqlite3 for local development
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL (recommended for production):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom
# DB_USER=smartanom_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# For MySQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=smartanom
# DB_USER=smartanom_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306

# ----------------------------------------------------------------------------
# CORS Settings (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------
# Required for React frontend to communicate with Django backend
# In development, CORS_ALLOW_ALL_ORIGINS=true is automatically set
# In production, specify exact allowed origins (comma-separated):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# ----------------------------------------------------------------------------
# Push Notifications (Web Push / VAPID)
# ----------------------------------------------------------------------------
# VAPID keys for Web Push notifications (REQUIRED for push notifications to work)
# Generate new keys with: python manage.py generate_vapid_keys
# Or using Python: from pywebpush import webpush; webpush.generate_vapid_keys()
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# ----------------------------------------------------------------------------
# Email Configuration (OTP Authentication)
# ----------------------------------------------------------------------------
# Development: Console email backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: Brevo (Sendinblue) SMTP
# Set these to enable SMTP sending via Django's SMTP backend
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-username
SMTP_PASS=your-brevo-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SmarTanom <noreply@yourdomain.com>

# Alternative: Brevo HTTP API (recommended on hosts that block SMTP ports like Render free tier)
# Set EMAIL_TRANSPORT=brevo_api and provide BREVO_API_KEY. SMTP_* may be omitted in this mode.
EMAIL_TRANSPORT=smtp
BREVO_API_KEY=

# Legacy fallback variables (optional; only if you already use these)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ----------------------------------------------------------------------------
# OTP (One-Time Password) Settings
# ----------------------------------------------------------------------------
# OTP expiration time in seconds (default: 300 = 5 minutes)
OTP_EXPIRATION_SECONDS=300
# Alternative: OTP_EXPIRE_MINUTES=5

# OTP code length (default: 6 digits)
OTP_CODE_LENGTH=6

# Maximum OTP verification attempts before locking (default: 5)
OTP_MAX_ATTEMPTS=5

# Rate limit cooldown period in seconds (default: 900 = 15 minutes)
OTP_RATE_LIMIT_PERIOD=900
# Alternative: OTP_RATE_LIMIT_WINDOW=900

# Maximum OTP requests allowed in rate limit window (default: 5)
OTP_MAX_LOGIN_ATTEMPTS=5
# Alternative: OTP_RATE_LIMIT_MAX=5

# ----------------------------------------------------------------------------
# DRF (Django REST Framework) Throttling
# ----------------------------------------------------------------------------
# API rate limits (format: number/period, e.g., 1000/day, 100/hour)
# Increased for development; reduce in production
DRF_USER_THROTTLE=100000/day
DRF_ANON_THROTTLE=10000/day
OTP_REQUEST_THROTTLE=100/hour
OTP_VERIFY_THROTTLE=200/hour
LOGIN_ATTEMPT_THROTTLE=300/hour

# ----------------------------------------------------------------------------
# Google Account Validation Policy (Server-side; no Google popup)
# ----------------------------------------------------------------------------
# If you want to restrict sign-in to specific Google Workspace domains, set
# GOOGLE_REQUIRE_DOMAIN to a comma-separated list (e.g., example.com,another.com).
# Leave it empty to allow gmail.com and other Google-managed addresses.
GOOGLE_REQUIRE_DOMAIN=
# Optionally require MX records to match Google Workspace. Set to true to enforce.
GOOGLE_ENFORCE_MX=false
# Optional Google OAuth client info (not required for OTP-only auth). Present for future use/tests.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ----------------------------------------------------------------------------
# Redis Configuration (Optional - for Celery/Caching)
# ----------------------------------------------------------------------------
# Uncomment if using Redis for Celery task queue or caching
# REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Alerts & Notifications
# ----------------------------------------------------------------------------
# Suppress duplicate alerts for the same sensor+metric and same-or-lower severity
# within this cooldown window (minutes). Escalations (e.g., warning -> critical)
# are allowed during the window.
ALERT_COOLDOWN_MINUTES=30

# ----------------------------------------------------------------------------
# Static & Media Files
# ----------------------------------------------------------------------------
# In development, Django serves these automatically
# In production, configure web server (nginx/Apache) to serve these paths
# STATIC_ROOT=/var/www/smartanom/staticfiles
# MEDIA_ROOT=/var/www/smartanom/media
# STATIC_URL=/static/
# MEDIA_URL=/media/

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FILE=logs/django.log

# ----------------------------------------------------------------------------
# Security Settings (Automatically Applied in Production)
# ----------------------------------------------------------------------------
# When DEBUG=false, these security settings are automatically enabled:
# - SECURE_SSL_REDIRECT=true (redirect HTTP to HTTPS)
# - SESSION_COOKIE_SECURE=true (cookies only over HTTPS)
# - CSRF_COOKIE_SECURE=true (CSRF cookies only over HTTPS)
# - SECURE_HSTS_SECONDS=31536000 (1 year HSTS)
# - SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# - SECURE_HSTS_PRELOAD=true
# - SECURE_CONTENT_TYPE_NOSNIFF=true
# - SECURE_BROWSER_XSS_FILTER=true
# - X_FRAME_OPTIONS=DENY
# You don't need to set these manually; they're handled by settings.py

# ----------------------------------------------------------------------------
# Custom User Model (Pre-configured)
# ----------------------------------------------------------------------------
# AUTH_USER_MODEL=accounts.User
# The system uses a custom user model with email-based authentication (no passwords)
# Users log in using email + OTP (one-time password) sent via email

# ----------------------------------------------------------------------------
# Device Provisioning Settings
# ----------------------------------------------------------------------------
# API key for ESP32 devices to authenticate provisioning requests
# Devices must send this in X-Device-Auth header when calling /api/devices/provision/
# In development (DEBUG=true), this is optional. In production, it's required.
#
# ⚠️ IMPORTANT: This key must match the DEVICE_API_KEY in your ESP32 firmware!
#    ESP32 firmware location: firmware/esp32-smartanom/esp32-smartanom.ino
#    Look for: #define DEVICE_API_KEY "your-key-here"
#
# Production example (from Render): b58e766d66ea4fededf05d3ccfe44475
DEVICE_PROVISION_API_KEY=dev-insecure-device-key

# Auto-create device record on first provision attempt if device not found
# When true: ESP32 can self-register on first WiFi connection
# When false: Device must be pre-created in admin before provisioning
AUTO_CREATE_DEVICE_ON_FIRST_CONNECT=true

# Rate limit for device provisioning endpoint (format: requests/period)
# Examples: 10/hour, 100/day, 5/minute
DEVICE_PROVISION_THROTTLE_RATE=10/hour

# ----------------------------------------------------------------------------
# ESP32 Firmware Configuration Reference
# ----------------------------------------------------------------------------
# For your ESP32 devices, ensure these settings match in the firmware:
#
# 1. Backend URL (firmware/esp32-smartanom/esp32-smartanom.ino):
#    #define BACKEND_URL "https://smartanom-backend.onrender.com"
#
#    ⚠️ Common mistake: Using "smartanom.onrender.com" (missing "-backend")
#    The correct production URL is: smartanom-backend.onrender.com
#
# 2. API Key (must match DEVICE_PROVISION_API_KEY above):
#    #define DEVICE_API_KEY "b58e766d66ea4fededf05d3ccfe44475"
#
# 3. Device Serial (unique per device):
#    #define DEVICE_SERIAL "SMRT-XXX-XXX"
#    Format must be: SMRT-[A-Z0-9]{3}-[A-Z0-9]{3}
# ----------------------------------------------------------------------------


