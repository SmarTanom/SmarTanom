# ============================================================================
# SmarTanom Frontend Environment Configuration (Vite + React PWA)
# ============================================================================
# Copy this file to .env for local development
# Copy to .env.production for production builds
# NEVER commit .env files to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Backend API Configuration
# ----------------------------------------------------------------------------
# Base URL for Django REST API
# Development: Point to local Django server
VITE_API_BASE_URL=https://smartanom.onrender.com

# Production: Point to your production domain
# VITE_API_BASE_URL=https://api.yourdomain.com

# ----------------------------------------------------------------------------
# WebSocket Configuration (Optional - if using Django Channels)
# ----------------------------------------------------------------------------
# WebSocket endpoint for real-time features (not currently implemented)
# VITE_WS_URL=ws://127.0.0.1:8000/ws
# VITE_WS_URL=wss://api.yourdomain.com/ws

# ----------------------------------------------------------------------------
# PWA Configuration
# ----------------------------------------------------------------------------
# Application name (displayed when installed as PWA)
VITE_APP_NAME=SmarTanom

# Application short name (displayed on home screen)
VITE_APP_SHORT_NAME=SmarTanom

# Application description
VITE_APP_DESCRIPTION=Smart Hydroponics Monitoring System

# Theme color (for PWA manifest and browser UI)
VITE_THEME_COLOR=#10b981

# Background color (for splash screen)
VITE_BACKGROUND_COLOR=#ffffff

# ----------------------------------------------------------------------------
# Push Notifications
# ----------------------------------------------------------------------------
# VAPID public key for Web Push subscriptions
# Get this from your Django backend: /api/notifications/subscriptions/vapid_public_key/
# Or generate with: python manage.py generate_vapid_keys
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Note: The app fetches this dynamically from the backend API
# You only need to set this if you want to hardcode it (not recommended)

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features during development
VITE_ENABLE_PWA=true
VITE_ENABLE_PWA_IN_DEV=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Enable debug mode (shows additional console logs)
# VITE_DEBUG=true

# Mock API responses for frontend-only development
# VITE_USE_MOCK_API=false

# ----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# ----------------------------------------------------------------------------
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ----------------------------------------------------------------------------
# Build Configuration
# ----------------------------------------------------------------------------
# Base URL for production deployment (if deployed to subdirectory)
# VITE_BASE_URL=/
# VITE_BASE_URL=/smartanom/

# ----------------------------------------------------------------------------
# Notes for Deployment
# ----------------------------------------------------------------------------
# 1. For production, create .env.production with your production values
# 2. Build command will automatically use .env.production: npm run build
# 3. Ensure VITE_API_BASE_URL points to your production backend
# 4. All VITE_* variables are embedded in the build at build time
# 5. Do NOT put sensitive secrets here - they will be visible in the client bundle!
