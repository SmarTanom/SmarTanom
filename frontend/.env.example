# Frontend environment variables (Vite)
# Copy this file to `.env` for local development or `.env.production` for production builds.
# Do not commit real secrets; use only non-sensitive values here.

# Backend API base URL. If omitted, the app may fall back to window.location.origin in dev.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: WebSocket endpoint (not used unless your build integrates WS)
# VITE_WS_URL=ws://127.0.0.1:8000/ws
