# Production Environment Variables
# Copy this file to .env.prod and fill in the actual values

# Database Configuration
POSTGRES_DB=smartanom_prod
POSTGRES_USER=smartanom
POSTGRES_PASSWORD=your_secure_database_password_here

# Django Configuration
SECRET_KEY=your_very_long_secret_key_here_minimum_50_characters_recommended
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# Email Configuration (for notifications and password reset)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=1

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Optional: External services
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_STORAGE_BUCKET_NAME=your_s3_bucket

# Optional: Monitoring and logging
# SENTRY_DSN=your_sentry_dsn_for_error_tracking