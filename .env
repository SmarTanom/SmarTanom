###############################
# SmarTanom Environment Example
# Copy to .env (never commit real secrets)
###############################

# === Django Core ===
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me-with-a-random-long-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (SQLite default) ===
# For Postgres (example):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom
# DB_USER=smartanom
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# === CORS / CSRF ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Email / SMTP (Brevo is recommended for production) ===
# Dev only (logs to console):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Brevo SMTP (recommended)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# New-style vars preferred by settings.py
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL="SmarTanom <no-reply@smartanom.com>"

# === OTP Settings ===
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# === Logging ===
LOG_LEVEL=INFO

# === Frontend Origin (for absolute links in emails) ===
FRONTEND_BASE_URL=http://localhost:5173

# === Future Integrations (placeholders) ===
# REDIS_URL=redis://localhost:6379/1
# SENTRY_DSN=https://public@sentry.example/1
