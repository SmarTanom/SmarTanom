# Example environment variables for SmartAnom
# Copy to .env and fill values for local development or deployment

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-secure-key
ALLOWED_HOSTS=*
ADMIN_URL=admin/

# Database (Render Postgres example)
DATABASE_URL=postgresql://smartanom_storgae_user:password@host:5432/smartanom_storgae

# SendGrid (API-based email backend)
SENDGRID_API_KEY=
EMAIL_BACKEND=sendgrid_backend.SendgridBackend
DEFAULT_FROM_EMAIL="SmartAnom System <smartanom01@gmail.com>"

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://192.168.56.1:5173,http://192.168.1.12:5173

# Channels / Redis (optional in production)
REDIS_URL=redis://localhost:6379/0

# Superuser to create at deploy
SUPERUSER_EMAIL=smartanom01@gmail.com
SUPERUSER_USERNAME=smartanom01@gmail.com
SUPERUSER_PASSWORD=smartanomadmin4r1
###############################
# SmarTanom Environment Example
# Copy to .env (never commit real secrets)
###############################

# === Django Core ===
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me-with-a-random-long-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (SQLite default) ===
# For Postgres (example):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartanom
# DB_USER=smartanom
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# === CORS / CSRF ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Email / SMTP (configure for real OTP delivery) ===
# To use console backend (dev only):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production-like SMTP (Gmail example with App Password):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your_gmail_account@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL="SmarTanom <no-reply@smartanom.com>"

# If using a provider (SendGrid):
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=sendgrid_api_key

# === OTP Settings ===
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# === Logging ===
LOG_LEVEL=INFO

# === Frontend Origin (for absolute links in emails) ===
FRONTEND_BASE_URL=http://localhost:5173

# === Future Integrations (placeholders) ===
# REDIS_URL=redis://localhost:6379/1
# SENTRY_DSN=https://public@sentry.example/1
