# SmarTanom Docker Environment Configuration
# Copy this file to .env and modify as needed

# ======================
# Application Settings
# ======================

# Node environment (development, staging, production)
NODE_ENV=development

# Clear Expo cache on startup (true/false)
CLEAR_CACHE=false

# ======================
# Expo Configuration
# ======================

# Expo development server listen address
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0

# React Native packager hostname
REACT_NATIVE_PACKAGER_HOSTNAME=0.0.0.0

# Disable Expo doctor checks (speeds up startup)
EXPO_CLI_NO_DOCTOR=1

# ======================
# Port Configuration
# ======================

# Web development server port (default: 3000)
WEB_PORT=3000

# Expo development server port (default: 19000)
EXPO_PORT=19000

# Metro bundler port (default: 8081)
METRO_PORT=8081

# ======================
# Development Settings
# ======================

# Enable hot reloading (true/false)
HOT_RELOAD=true

# Enable fast refresh (true/false)
FAST_REFRESH=true

# ======================
# Network Settings
# ======================

# Docker network name
NETWORK_NAME=smartanom-network

# Container name
CONTAINER_NAME=smartanom-mobile-app

# ======================
# Volume Settings
# ======================

# Enable source code volume mounting for development (true/false)
# Set to false for production deployments
ENABLE_SOURCE_VOLUME=true

# ======================
# Logging Settings
# ======================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false

# ======================
# Security Settings
# ======================

# Run container as non-root user (recommended: true)
USE_NON_ROOT_USER=true

# User ID for container user (default: 1001)
USER_ID=1001

# Group ID for container user (default: 1001)
GROUP_ID=1001
