# =============================================================================
# SmarTanom Production Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env.production and update all values
# DO NOT commit this file with real credentials to version control
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_PASSWORD=your_secure_database_password_here
DATABASE_URL=postgres://smartanom:your_secure_database_password_here@postgres:5432/smartanom_prod

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0

# =============================================================================
# DJANGO SECURITY CONFIGURATION
# =============================================================================
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_super_secret_django_key_minimum_50_characters_long_change_this

# Add your domain names here (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Add your frontend domain(s) here (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For Gmail, use smtp.gmail.com and an app password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_app_password_here
DEFAULT_FROM_EMAIL=SmarTanom <noreply@yourdomain.com>

# For AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_ses_username
# EMAIL_HOST_PASSWORD=your_ses_password

# For Brevo SMTP
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_brevo_smtp_login
# EMAIL_HOST_PASSWORD=your_brevo_smtp_password

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Gunicorn worker configuration (adjust based on your server specs)
GUNICORN_WORKERS=3
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_MAX_REQUESTS=1000
GUNICORN_TIMEOUT=30

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# BACKUP CONFIGURATION (Optional)
# =============================================================================
# BACKUP_S3_BUCKET=your-backup-bucket
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Change ALL default passwords above
# 2. Use strong, unique passwords (minimum 16 characters)
# 3. Enable 2FA on your email account used for Django emails
# 4. Regularly rotate your SECRET_KEY and passwords
# 5. Monitor your logs for suspicious activity
# 6. Keep your Docker images updated
# 7. Use a reverse proxy (nginx) in front of this setup
# 8. Enable SSL/TLS certificates (Let's Encrypt recommended)
# 9. Configure firewall rules to restrict access
# 10. Regular database backups are essential
