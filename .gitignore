###############################################
# Global ignores for this monorepo
###############################################

# Python virtual environments
.venv/
venv/
ENV/

# Python caches and tooling
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/

# Django local artifacts
*.sqlite3
*.sqlite3.backup
db.sqlite3
db.sqlite3.backup
logs/
backend/logs/
staticfiles/

# Environment files (never commit secrets)
.env
.env.*
backend/.env
frontend/.env
mobile/.env

# Node modules
node_modules/
frontend/node_modules/
mobile/node_modules/

# Vite/Parcel caches and build
dist/
.cache/
.parcel-cache/

# Expo / React Native
.expo/
.expo-shared/
*.expo/
android/
ios/
web-build/
*.apk
*.aab
*.ipa

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Misc CI/build
.vercel/
.turbo/
