# Ignore dependency modules / environments and common build caches

# Python virtual environments
.venv/
venv/
ENV/

# Node modules
frontend/node_modules/
mobile/node_modules/
node_modules/

# Expo / Metro / React Native caches
.expo/
.expo-shared/
*.expo/
dist/
.cache/
.parcel-cache/
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build outputs
android/
ios/
web-build/
build/
*.apk
*.aab
*.ipa

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd



# Environment variables (sensitive)
.env
.env.local
.env.development
.env.production
.env*.local

# Test/probe files (temporary)
*_probe.py
tmp_*.py

# Frontend build artifacts
frontend/dist/

# (Keep everything else versioned intentionally)
