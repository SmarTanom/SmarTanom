# Ignore dependency modules / environments and common build caches

# Python virtual environments
.venv/
venv/
ENV/

# Node modules
frontend/node_modules/
mobile/node_modules/
node_modules/

# Expo / Metro / React Native caches
.expo/
.expo-shared/
*.expo/
dist/
.cache/
.parcel-cache/
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build outputs
android/
ios/
web-build/
build/
*.apk
*.aab
*.ipa

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Django collected static and media uploads (generated)
backend/staticfiles/
backend/media/
backend/logs/
backend/logs/*.log

# Keep directories with placeholders
!backend/staticfiles/.gitkeep
!backend/media/.gitkeep
!backend/media/device_photos/.gitkeep
!backend/media/user_photos/.gitkeep
!backend/logs/.gitkeep



# Environment variables (sensitive)
#.env
#.env.local
#.env.development
#.env.production
#.env*.local
#backend/.env
#backend/.env.local
#backend/.env.development
#backend/.env.production

# Test/probe files (temporary)
*_probe.py
tmp_*.py

# Frontend build artifacts
frontend/dist/


# Ignore local SQLite database
backend/db.sqlite3
backend/db.sqlite3.local_backup

# Generic database files (do not commit local DB data)
db.sqlite3
*.sqlite3
*.sqlite
*.db

# SQLite journal/WAL/shared memory files
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db-journal
*-wal
*-shm

# Optional: local DB dumps (uncomment if you produce local dumps)
# *.sql
# *.dump

# Backend temp/debug helpers
backend/debug_*.py
backend/tmp_*.py
backend/tmp_*.json
backend/tmp*.json
backend/tmp*.py
