ARG PYTHON_VERSION=3.12.5
ARG ALPINE_VERSION=3.20
ARG INSTALL_DEV=false

# ================= Builder Stage =================
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /build
RUN apk add --no-cache --virtual .build-deps \
    build-base \
    postgresql15-client \
    libpq \
    linux-headers
COPY backend/requirements.txt ./
RUN python -m pip install --upgrade pip setuptools wheel
RUN pip install -r requirements.txt
RUN if [ "$INSTALL_DEV" = "true" ]; then pip install django-debug-toolbar django-extensions ipython; fi
COPY backend/ ./
RUN python -m compileall -q .

# ================= Runtime Stage =================
FROM python:${PYTHON_VERSION}-alpine${ALPINE_VERSION} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=smartanom.settings \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apk add --no-cache postgresql15-client libpq
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /build /app

# Create directories and fix permissions
RUN mkdir -p /app/logs

# Create user and set ownership
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Fix line endings, make executable, and ensure proper ownership
RUN if [ -f /app/entrypoint.sh ]; then \
        sed -i 's/\r$//' /app/entrypoint.sh && \
        chmod +x /app/entrypoint.sh && \
        chown appuser:appgroup /app/entrypoint.sh; \
    else \
        echo "#!/bin/sh" > /app/entrypoint.sh && \
        echo "set -e" >> /app/entrypoint.sh && \
        echo "python manage.py migrate --noinput" >> /app/entrypoint.sh && \
        echo "python manage.py runserver 0.0.0.0:8000" >> /app/entrypoint.sh && \
        chmod +x /app/entrypoint.sh && \
        chown appuser:appgroup /app/entrypoint.sh; \
    fi

# Set ownership for all app files
RUN chown -R appuser:appgroup /app

USER appuser
EXPOSE 8000

LABEL org.opencontainers.image.source="SmarTanom" \
    org.opencontainers.image.description="SmarTanom backend (multi-stage)" \
    org.opencontainers.image.licenses="Proprietary"

ENTRYPOINT ["/app/entrypoint.sh"]
